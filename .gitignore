# ──────────────────────────────────────────────────────────────────────────────
# AlgoDesk .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── P2 SECURITY FIX (2026-04-11) ─────────────────────────────────────────────
# cert.pem and key.pem are generated by the Upstox OAuth flow and contain the
# TLS private key for the local HTTPS redirect server.  They must NEVER be
# committed to version control.
#
# token.json stores the live Upstox bearer token (access_token + refresh_token).
# Committing it would give any repository reader full API access to the account.
#
# Explicit paths (belt):
broker/upstox/cert.pem
broker/upstox/key.pem
broker/upstox/token.json
*.pem
#
# Wildcard (suspenders) — catches certs regenerated to any location:
*.pem
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Environment / secrets ─────────────────────────────────────────────────────
# Keep .env.example but not the real .env file
.env
!.env.example
*.key
*.p12
*.pfx

# ── Data directories ──────────────────────────────────────────────────────────
